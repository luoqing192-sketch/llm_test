NODE_ENV=production
PORT=3000

# MySQL
MYSQL_HOST=prod-db
MYSQL_USER=chatapp
MYSQL_PASSWORD=
MYSQL_DATABASE=chatapp_prod
MYSQL_CONNECTION_LIMIT=30

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LLM API
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=***
LLM_MODEL=gpt-3.5-turbo
LLM_MAX_CONCURRENT=10
LLM_REQUEST_TIMEOUT=60000

# Auth
JWT_SECRET=***
JWT_EXPIRES_IN=30d

# Logging
LOG_LEVEL=warn
